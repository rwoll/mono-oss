# pnpm 11 reads only the registry and auth settings here. Its supply-chain policy
# (7-day minimumReleaseAge with @rwoll/* exempt, no dependency install scripts)
# lives in pnpm-workspace.yaml; the same policy is repeated below for anyone who
# runs npm here by mistake. oss/.npmrc must match this file (`pnpm sync:oss`).
registry=https://registry.npmjs.org/
ignore-scripts=true
min-release-age=7
min-release-age-exclude[]=@rwoll/*
