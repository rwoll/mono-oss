{
  "name": "@rwoll/create-canvas",
  "version": "0.3.0",
  "description": "Create a Copilot plugin marketplace with a TypeScript and React canvas: npm create @rwoll/canvas",
  "keywords": [
    "copilot",
    "github-copilot",
    "canvas",
    "create"
  ],
  "license": "MIT",
  "author": "Ross A. Wollman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwoll/mono-oss.git",
    "directory": "packages/create-canvas"
  },
  "homepage": "https://github.com/rwoll/mono-oss/tree/main/packages/create-canvas#readme",
  "bugs": "https://github.com/rwoll/mono-oss/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "create-canvas": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rwoll/canvas-kit": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
