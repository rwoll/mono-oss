# The desktop session's environment. The session and `blobby-sandbox exec` commands both use it.
DISPLAY=:1
XDG_RUNTIME_DIR=/run/user/1000
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/user/1000/system_bus_socket
XDG_SESSION_TYPE=x11
XDG_SESSION_CLASS=user
XDG_SESSION_DESKTOP=ubuntu
DESKTOP_SESSION=ubuntu
XDG_CURRENT_DESKTOP=ubuntu:GNOME
GNOME_SHELL_SESSION_MODE=ubuntu
XDG_CONFIG_DIRS=/etc/xdg/xdg-ubuntu:/etc/xdg
XDG_DATA_DIRS=/usr/share/ubuntu:/usr/local/share:/usr/share
LIBGL_ALWAYS_SOFTWARE=1
LANG=C.UTF-8
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
